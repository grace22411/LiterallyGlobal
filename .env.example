# Next.js server origin: use the exact origin visitors use, with HTTPS in production.
APP_URL=http://localhost:3000

# Supabase project settings. Keep service-role credentials server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key and a sender on your verified domain.
RESEND_API_KEY=
EMAIL_FROM=

# Random secret of at least 32 characters for the scheduled email retry endpoint.
CRON_SECRET=

# Verified account emails allowed into /admin (comma-separated). Empty denies everyone.
ADMIN_EMAILS=

# Stripe test-mode keys first. Register /api/payments/webhook with Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Grace AI: server-only key and a model that supports Responses + structured outputs.
OPENAI_API_KEY=
OPENAI_MODEL=

# Business WhatsApp number with country code, e.g. +44... (no example number is published).
SUPPORT_WHATSAPP_NUMBER=
